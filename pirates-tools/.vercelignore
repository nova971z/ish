# Fichiers présents dans le repo mais JAMAIS déployés sur Vercel.
# images/_originals : sauvegardes haute résolution des assets (logos, icônes)
# conservées dans git pour réversibilité — non servies aux visiteurs, elles ne
# doivent pas alourdir le déploiement.
images/_originals/

# models/ : fichiers SOURCES des packs 3D (composants des builders
# scratchpad/_gltftools — Tstack, chargeur, batteries, outils nus) et essais.
# Conservés dans git (registre des orientations, re-builds), JAMAIS servis :
# aucun n'est référencé par products.json ni par le client. ~21 Mo de
# déploiement économisés. Vérifié par script (réfs .model + app.js + index.html).
models/dewalt-optimized.glb
models/tools.json
models/Tools
models/products/DCD996.glb
models/products/DCS334N.glb
models/products/Tstack.glb
models/products/dcb1104.glb
models/products/dcb118.glb
models/products/dcd796.glb
models/products/dcf850.glb
models/products/dcf887.glb
models/products/dcs391n.glb

# crypto-config.js : vestige NON charge par la page (la config crypto vit dans
# le script inline #3 d'index.html, source unique). Conserve en git pour
# memoire, jamais deploye (adresses dupliquees = derive garantie).
crypto-config.js

# tests/ et outils/ : harnais de vérification et fabricants de packs 3D.
# Versionnés dans git (ils protègent la livraison, les paiements, la 2FA et
# permettent de refaire un pack 3D), mais JAMAIS servis aux visiteurs : ils
# n'ont rien à faire dans le déploiement.
tests/
outils/

# archives/ : fiches produit retirees du site et rangees (decision user 04/08).
# Presentes dans git pour etre recuperables, JAMAIS deployees — meme mecanisme
# que images/_originals/. Elles ne doivent ni alourdir le site ni y reapparaitre.
archives/
