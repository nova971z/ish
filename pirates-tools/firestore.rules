rules_version = '2';

// ============================================================================
// Pirates Tools — Règles de sécurité Firestore (S1)
// ============================================================================
//
// MODÈLE DE CONFIANCE
//   • Le SDK client (navigateur) est SOUMIS à ces règles.
//   • L'Admin SDK serveur (api/_lib/firebase.js, webhook) les CONTOURNE
//     totalement — c'est lui, et lui seul, qui écrit les données autoritaires
//     (statut 'paid', journal des paiements, idempotence, overrides catalogue).
//
// PRINCIPE : DEFAULT-DENY. Toute collection non couverte par un `match`
// explicite ci-dessous est refusée en lecture ET écriture (règle finale
// catch-all). On n'ouvre QUE ce qui est strictement nécessaire au client.
//
// Déploiement : `firebase deploy --only firestore:rules`
// Test : `firebase emulators:exec --only firestore "node scripts/test-rules.js"`
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Participant d'une DISCUSSION DIRECTE client ↔ livreur (hors course).
    // On lit le document parent, que le client ne peut PAS écrire. Une
    // conversation inexistante fait échouer le get() → refus (fail-closed).
    function isConvParticipant(convId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/conversations/$(convId))
        && (get(/databases/$(database)/documents/conversations/$(convId)).data.clientUid == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(convId)).data.courierUid == request.auth.uid);
    }
    // Participant d'une course = le client qui l'a commandée OU le livreur qui
    // l'a acceptée. Lu dans le document parent courses/{id} — que le client ne
    // peut PAS lire lui-même (get() en règle contourne les règles de lecture).
    // Une course inexistante fait échouer le get() → accès refusé (fail-closed).
    function isCourseParticipant(courseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && (get(/databases/$(database)/documents/courses/$(courseId)).data.artisanUid == request.auth.uid
            || get(/databases/$(database)/documents/courses/$(courseId)).data.courierUid == request.auth.uid);
    }
    // N° de mise en relation en cours. Incrémenté par le serveur à chaque
    // « remise en ligne » (course-release) : le fil précédent devient
    // inaccessible aux DEUX côtés, si bien que le livreur suivant ne lira
    // jamais la conversation d'avant. Défaut 1 pour les courses antérieures.
    function courseRound(courseId) {
      return ('round' in get(/databases/$(database)/documents/courses/$(courseId)).data)
        ? get(/databases/$(database)/documents/courses/$(courseId)).data.round : 1;
    }

    // ---- users/{uid} : profil client, self-only ---------------------------
    // Un utilisateur ne peut lire/écrire QUE son propre document. Les champs
    // sont restreints à une allowlist (anti mass-assignment) : impossible
    // d'injecter un champ arbitraire (ex. un rôle, un privilège). Le champ
    // `loyalty` reste toléré mais est INERTE côté sécurité — la remise réelle
    // est calculée serveur depuis la collection `payments/` (webhook-only),
    // jamais depuis ce champ.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'phone', 'address', 'avatar', 'loyalty', 'createdAt']);
      // Droit à l'oubli (M4) : le titulaire peut supprimer SON propre profil
      // (flux « supprimer mon compte » : purge orders + profil + Auth). Le
      // journal comptable payments/ (server-only) reste conservé au titre des
      // obligations légales de conservation.
      allow delete: if isOwner(userId);

      // ---- users/{uid}/orders : commandes du client -----------------------
      // Le client peut CRÉER ses propres lignes de commande, mais UNIQUEMENT
      // avec un statut non-payé ('quote' = devis WhatsApp, 'pending' =
      // paiement initié, 'declared' = crypto déclaré à vérifier). Il ne peut
      // JAMAIS écrire 'paid' ni les tampons serveur (confirmedByWebhook,
      // paidAt…) : seul le webhook (Admin SDK) confirme un paiement. Il ne
      // peut ni modifier ni supprimer une commande existante.
      //
      // NOTE canal crypto DÉSACTIVÉ (16/07/2026) : 'declared' (commande crypto
      // annoncée par le client, à vérifier à la main) est RETIRÉ de la liste
      // blanche → même en forçant le SDK, personne ne peut fabriquer une
      // commande crypto. RÉACTIVER = remettre 'declared' ci-dessous ET
      // PT_CRYPTO_ENABLED=true dans app.js.
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.status in ['quote', 'pending']
          && !request.resource.data.keys().hasAny(
               ['confirmedByWebhook', 'paidAt', 'stripePaymentIntent'])
          && request.resource.data.keys().hasOnly(
               ['date', 'items', 'lines', 'total', 'status',
                'method', 'paymentIntentId', 'stripeSessionId'])
          && (!('total' in request.resource.data) || request.resource.data.total is number)
          && (!('items' in request.resource.data) || request.resource.data.items is number);
        // Confirmation/mise à jour = Admin SDK serveur uniquement.
        allow update: if false;
        // Suppression : le titulaire peut effacer ses propres commandes
        // (droit à l'oubli — M4).
        allow delete: if isOwner(userId);
      }
    }

    // ---- partners/{id} : annuaire public « Nos artisans » ------------------
    // Cartes de l'annuaire partenaires (Phase 2 abonnements). Données PUBLIQUES
    // par nature (l'artisan souscrit précisément pour être affiché) : lecture
    // ouverte à tous (la page #/artisans lit via le SDK client — pas de 13e
    // fonction Vercel possible, plan Hobby 12/12). Écriture SERVEUR UNIQUEMENT
    // (admin.js type=partner-save/partner-delete via Admin SDK, requireAdmin).
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Collections SERVEUR UNIQUEMENT (Admin SDK, contourne les règles) --
    // Aucune de ces collections n'est jamais lue ni écrite par le client.
    // Les fermer explicitement documente l'intention (et double le catch-all).
    match /partner_applications/{appId} { allow read, write: if false; } // pré-inscriptions artisans (Phase 3a) : écrites par contact.js (Admin SDK), lues par l'admin
    match /partners_private/{partnerId} { allow read, write: if false; } // marqueur invité/payant + uid lié des partenaires — JAMAIS public (partners/ l'est, lui)
    match /invite_codes/{code}          { allow read, write: if false; } // codes d'invitation Black — validés par contact.js (Admin SDK), jamais lisibles/forgeables client
    match /payments/{paymentId}        { allow read, write: if false; } // journal paiements (email/CP/montants)
    match /stripe_events/{eventId}     { allow read, write: if false; } // idempotence webhook
    match /rate_limits/{bucketId}      { allow read, write: if false; } // compteurs anti-abus (IP)
    match /product_overrides/{prodId}  { allow read, write: if false; } // prix/stock admin
    match /charges/{chargeId}          { allow read, write: if false; } // charges comptables (admin)
    match /refunds/{refundId}          { allow read, write: if false; } // remboursements saisis (admin) — ≠ charges : ils annulent du CA et de la TVA COLLECTÉE
    match /config/{docId}              { allow read, write: if false; } // config serveur (prix, facturation)
    match /price_watch_log/{runId}     { allow read, write: if false; } // journal du traqueur de prix
    // ── Service coursier (Ubur) — construit mais INACTIF (COURIER_ENABLED=false).
    // Fermé au client tant que le module n'est pas ouvert + validé avocat.
    match /couriers/{uid}              { allow read, write: if false; } // profils coursiers + statut KYC
    match /courier_applications/{uid}  { allow read, write: if false; } // candidatures + pièces (SIRET, assurance, permis…)

    // ---- couriers_public/{uid} : FICHE PUBLIQUE du livreur -----------------
    // Miroir public écrit par le serveur (contact.js → mirrorCourierPublic,
    // Admin SDK) : nom affiché, photo, commune, véhicule, SES tarifs par zone,
    // disponibilité, nombre de courses terminées, note moyenne et avis.
    // Lecture OUVERTE (l'annuaire livreurs se lit via le SDK client — même
    // schéma que partners/, pas de fonction Vercel supplémentaire possible).
    // Écriture SERVEUR UNIQUEMENT : un livreur ne peut ni gonfler son compteur,
    // ni s'inventer des avis, ni s'afficher disponible sans passer par l'API.
    // AUCUNE donnée KYC/email/IBAN ici — elles restent dans couriers/{uid}.
    match /couriers_public/{uid}       { allow read: if true; allow write: if false; }

    // ---- courses/{id} : demandes de livraison ------------------------------
    // Le document lui-même reste SERVEUR UNIQUEMENT (montants, escrow, code de
    // remise). Seul le FIL DE DISCUSSION est ouvert aux deux participants.
    match /courses/{courseId} {
      allow read, write: if false;

      // Chat client ↔ livreur, ouvert dès qu'un livreur accepte la course.
      // Lecture/écriture réservées aux DEUX participants de CETTE course
      // (vérifiés dans le document parent, que le client ne peut pas lire).
      // Messages immuables : ni modification ni suppression — le fil fait foi
      // en cas de litige.
      // Le champ `round` cloisonne les mises en relation successives : on ne
      // lit et on n'écrit QUE dans le round courant de la course. Les requêtes
      // client doivent donc filtrer where('round','==',round) — c'est voulu.
      // Photos de preuve (chantier, colis remis, vue large) : SERVEUR UNIQUEMENT.
      // Le client les obtient via l'API (course-proof), qui verifie qu'il est
      // partie a la course — jamais en lecture directe.
      match /photos/{photoId} { allow read, write: if false; }

      match /messages/{messageId} {
        allow read: if isCourseParticipant(courseId)
          && resource.data.round == courseRound(courseId);
        allow create: if isCourseParticipant(courseId)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'text', 'at', 'round'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['client', 'livreur']
          && request.resource.data.round == courseRound(courseId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 800;
        allow update, delete: if false;
      }
    }

    // ---- conversations/{id} : DISCUSSION DIRECTE client ↔ livreur ---------
    // Ouverte depuis la carte d'un livreur EN SERVICE, sans passer par une
    // course. L'identifiant est déterministe (clientUid_courierUid) : un même
    // client ne peut pas ouvrir dix fils avec le même livreur.
    //
    // Le DOCUMENT est écrit par le serveur SEUL (contact.js → conv-open, Admin
    // SDK). C'est capital : c'est lui qui vérifie que le livreur est réellement
    // en service AVANT d'ouvrir le fil. Si le client pouvait créer le document,
    // il lui suffirait de le forger pour contourner cette vérification — et
    // pire, d'y inscrire n'importe quel uid comme participant, donc de
    // s'octroyer l'accès à la discussion de quelqu'un d'autre.
    // Lecture : les deux participants, pour afficher le fil et son en-tête.
    match /conversations/{convId} {
      allow read: if isSignedIn()
        && (resource.data.clientUid == request.auth.uid
            || resource.data.courierUid == request.auth.uid);
      allow write: if false;

      // Les MESSAGES, eux, sont écrits directement par les deux participants
      // (coût serverless nul, temps réel via onSnapshot). Immuables : ni
      // modification ni suppression — un fil qui peut être réécrit ne prouve
      // plus rien en cas de litige.
      match /messages/{messageId} {
        allow read: if isConvParticipant(convId);
        allow create: if isConvParticipant(convId)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'text', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['client', 'livreur']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 800;
        allow update, delete: if false;
      }
    }

    match /courier_locations/{uid}     { allow read, write: if false; } // géoloc temps réel (TTL court, RGPD)
    match /courier_config/{id}         { allow read, write: if false; } // barème/prix essence (écrit via admin API)

    // Mesure d'audience maison : écrite par l'Admin SDK (api/events.js), lue
    // UNIQUEMENT par l'API admin authentifiée (api/admin?type=stats). Jamais
    // par le client → fermé ici (double le catch-all, documente l'intention).
    // analytics_visitors contient le profil d'affinité des visiteurs CONSENTIS
    // (pseudonyme), effaçable au titre du droit à l'oubli.
    match /analytics_daily/{day}         { allow read, write: if false; }
    match /analytics_products/{prodId}   { allow read, write: if false; }
    match /analytics_clicks/{targetId}   { allow read, write: if false; }
    match /analytics_geo/{country}       { allow read, write: if false; }
    match /analytics_visitors/{visitorId}{ allow read, write: if false; }
    match /analytics_events_recent/{id}  { allow read, write: if false; }

    // ---- DEFAULT-DENY final : tout le reste est refusé --------------------
    // Une requête n'est autorisée que si AU MOINS une règle ci-dessus l'accorde.
    // Ce catch-all ne peut donc pas rouvrir un accès ; il verrouille toute
    // collection future oubliée. À NE PAS retirer.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
